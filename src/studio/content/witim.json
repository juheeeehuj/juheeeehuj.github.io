    "eyebrow": {
      "type": "text",
      "value": {
        "ko": "Design System & Component",
        "en": "Design System & Component"
      }
    },
    "headline": {
      "type": "text",
      "value": {
        "ko": "어두워질수록 ",
        "en": "The darker it gets, "
      }
    },
    "headlineMuted": {
      "type": "text",
      "value": {
        "ko": "브랜드는 밝아진다.",
        "en": "the brighter the brand."
      }
    },
    "lead": {
      "type": "text",
      "value": {
        "ko": "눈에 같은 인디고로 보이려면 어두운 바탕에서는 값을 밝혀야 합니다. 역할 토큰이 라이트·다크 두 값을 갖는 이유입니다.",
        "en": "To read as the same indigo, the value has to lift on a dark ground. That's why every role token carries two values — light and dark."
      }
    },
    "motion": {
      "type": "image",
      "src": "/work/witim-identity/motion/tokens.mp4",
      "alt": {
        "ko": "컴포넌트 카드가 떠다니며 라이트·다크로 갈아입는 모션",
        "en": "Motion of component cards floating and switching between light and dark"
      }
    },
    "clips": {
      "type": "list",
