---
// AX Studio 에서 옮겨 온 케이스스터디. 원본처럼 화면 전체를 쓰고, 블로그 헤더·푸터 대신 닫기(×) 버튼만 둔다.
// 색·글꼴·Tailwind 가 블로그와 달라서 BaseHead(global.css)를 쓰지 않고 head 를 따로 적는다.
import '../studio/studio.css';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { defaultLang, ui, type Lang } from '../i18n/ui';
import ChaisaCaseStudy from '../studio/chaisa/casestudy/ChaisaCaseStudy';
import RefineCaseStudy from '../studio/refine/RefineCaseStudy';
import WitimBranding from '../studio/witim/WitimBranding';
import YeosuCaseStudy from '../studio/yeosu/YeosuCaseStudy.astro';

type Props = CollectionEntry<'work'>['data'] & {
	renderer: NonNullable<CollectionEntry<'work'>['data']['renderer']>;
	lang: Lang;
	hreflang: Partial<Record<Lang, string>>;
};

const { title, description, cover, renderer, site, lang, hreflang } = Astro.props;
const t = ui[lang];

// 닫기 버튼 색: 케이스스터디 첫 화면 바탕에 맞춘다
const closeTone = {
	refine: 'border-black bg-white text-black hover:bg-black hover:text-white',
	witim: 'border-white/70 bg-black/30 text-white backdrop-blur hover:bg-white hover:text-black',
	chaisa: 'border-white/70 bg-[#0c1120]/90 text-white backdrop-blur hover:bg-white hover:text-black',
	yeosu: 'rounded-full border-[#dde3eb] bg-white text-[#16181d] hover:border-[#16181d] hover:bg-[#16181d] hover:text-white',
}[renderer];

// 버튼 위치: 여수새고막은 상단 메뉴바(52px) 안에 세로 가운데로 넣는다
const place =
	renderer === 'yeosu'
		? { site: 'right-[3.75rem] top-[6px] h-10', close: 'right-3 top-[6px] size-10 text-lg' }
		: { site: 'right-[4.75rem] top-6 h-11 md:right-[6.25rem] md:top-12', close: 'right-6 top-6 size-11 text-xl md:right-12 md:top-12' };

const pageTitle = `${title} | ${t.siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternates = Object.entries(hreflang).map(([l, path]) => ({ lang: l, href: new URL(path!, Astro.site).href }));
const xDefault = alternates.find((a) => a.lang === defaultLang)?.href ?? alternates[0]?.href;
const ogImage = new URL((await getImage({ src: cover, width: 1200, format: 'jpg' })).src, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{alternates.map(({ lang: l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
		{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

		<meta property="og:type" content="article" />
		<meta property="og:site_name" content={t.siteTitle} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,100..900&display=swap" rel="stylesheet" />
	</head>
	<body>
		{
			site && (
				<a
					class:list={[
						'fixed z-[100] flex items-center gap-1.5 border px-4 text-sm font-medium transition',
						place.site,
						closeTone,
					]}
					href={site}
					target="_blank"
					rel="noopener"
				>
					{t.visitSite}
					<span aria-hidden="true">↗</span>
				</a>
			)
		}
		<a
			aria-label={t.backToWork}
			class:list={[
				'fixed z-[100] grid place-items-center border transition',
				place.close,
				closeTone,
			]}
			href={`/${lang}/work/`}>×</a
		>
		{renderer === 'refine' && <RefineCaseStudy locale={lang} client:load />}
		{renderer === 'witim' && <WitimBranding locale={lang} client:load />}
		{renderer === 'chaisa' && <ChaisaCaseStudy locale={lang} client:load />}
		{renderer === 'yeosu' && <YeosuCaseStudy locale={lang} />}
	</body>
</html>
