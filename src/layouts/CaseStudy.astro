<script>
	import '../scripts/motion';

	// 목차: 지금 화면 위쪽에 있는 덩어리를 켠다
	const toc = document.querySelector<HTMLElement>('[data-toc-nav]');
	if (toc) {
		const list = toc.querySelector('ul')!;
		const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
		const targets = links
			.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
			.filter((el): el is HTMLElement => !!el);
		const update = () => {
			const line = toc.getBoundingClientRect().bottom + 40;
			let current = -1;
			targets.forEach((el, i) => {
				if (el.getBoundingClientRect().top <= line) current = i;
			});
			links.forEach((a, i) => {
				const on = i === current;
				if (on && a.getAttribute('aria-current') !== 'true') {
					list.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
				}
				a.setAttribute('aria-current', String(on));
			});
		};
		addEventListener('scroll', update, { passive: true });
		update();
	}
</script>
