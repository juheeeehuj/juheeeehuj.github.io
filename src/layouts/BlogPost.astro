---
// 글 상세 (Katen blog-single, 사이드바 없음)
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorBox from '../components/AuthorBox.astro';
import Avatar from '../components/Avatar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { blogUrl, categoryLabels, categoryUrl, ui, type Lang } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	lang: Lang;
	alternates: Record<Lang, string>;
	hreflang: Partial<Record<Lang, string>>;
	hasTranslation: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	lang,
	alternates,
	hreflang,
	hasTranslation,
} = Astro.props;
const t = ui[lang];
const selfUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
	title={`${title} | ${t.siteTitle}`}
	description={description}
	lang={lang}
	alternates={alternates}
	hreflang={hreflang}
	type="article"
	image={heroImage}
	navActive={blogUrl(lang)}
>
	<div class="container post-wrap">
		<nav aria-label={t.breadcrumb}>
			<ol class="breadcrumb">
				<li><a href={`/${lang}/`}>{t.navHome}</a></li>
				<li><a href={blogUrl(lang)}>{t.navBlog}</a></li>
				{
					category && (
						<li>
							<a href={categoryUrl(lang, category)}>{categoryLabels[lang][category]}</a>
						</li>
					)
				}
				<li class="current" aria-current="page">{title}</li>
			</ol>
		</nav>

		<article class="post-single">
			<header class="post-header">
				<h1 class="title">{title}</h1>
				<ul class="meta">
					<li class="author"><Avatar size={30} />{t.author}</li>
					{
						category && (
							<li>
								<a href={categoryUrl(lang, category)}>{categoryLabels[lang][category]}</a>
							</li>
						)
					}
					<li><FormattedDate date={pubDate} lang={lang} /></li>
					{
						updatedDate && (
							<li>
								{t.updatedOn}&nbsp;<FormattedDate date={updatedDate} lang={lang} />
							</li>
						)
					}
				</ul>
			</header>

			{
				heroImage && (
					<div class="featured-image">
						<Image src={heroImage} width={1560} alt="" />
					</div>
				)
			}

			{!hasTranslation && <p class="notice">{t.noTranslation}</p>}

			<div class="prose post-content">
				<slot />
			</div>

			<footer class="post-bottom">
				<div class="tags">
					{tags.map((tag) => <span class="tag">#{tag}</span>)}
				</div>
				<ShareLinks lang={lang} url={selfUrl} title={title} />
			</footer>
		</article>

		<AuthorBox lang={lang} />
	</div>
</BaseLayout>

<style>
	.post-wrap {
		max-width: calc(780px + 32px);
		margin-top: 20px;
	}
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 20px;
		padding: 0;
		list-style: none;
		color: var(--text-subtle);
		font-size: 14px;
	}
	.breadcrumb li + li::before {
		content: '/';
		margin-right: 0.5rem;
		color: var(--text-subtle);
	}
	.breadcrumb a {
		color: var(--text-subtle);
	}
	.breadcrumb a:hover {
		color: var(--pink);
	}

	.post-header {
		margin-bottom: 30px;
	}
	.title {
		margin: 0 0 1rem;
		font-size: 36px;
		line-height: 1.3;
	}
	.meta a {
		color: var(--text-subtle);
	}
	.meta a:hover {
		color: var(--pink);
	}
	.author {
		gap: 12px;
	}

	.featured-image {
		margin-bottom: 30px;
	}
	.featured-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}

	.notice {
		margin: 0 0 30px;
		padding: 12px 16px;
		border-radius: var(--radius);
		background: var(--surface);
		font-size: 14px;
	}

	.post-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 30px;
		padding-top: 30px;
		border-top: 1px solid var(--border);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tag {
		display: inline-block;
		padding: 3px 14px;
		border: 1px solid var(--border);
		border-radius: 25px;
		color: var(--text-muted);
		font-size: 13px;
	}

	@media (max-width: 767px) {
		.title {
			font-size: 26px;
		}
		.breadcrumb .current {
			display: none;
		}
		.post-bottom {
			flex-direction: column;
		}
	}
</style>
