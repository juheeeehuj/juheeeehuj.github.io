---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { ui, type Lang } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	lang: Lang;
	alternates: Record<Lang, string>;
	hreflang: Partial<Record<Lang, string>>;
	hasTranslation: boolean;
};

const { title, description, pubDate, updatedDate, heroImage, tags, lang, alternates, hreflang, hasTranslation } =
	Astro.props;
const t = ui[lang];
---

<BaseLayout
	title={`${title} | ${t.siteTitle}`}
	description={description}
	lang={lang}
	alternates={alternates}
	hreflang={hreflang}
	type="article"
	image={heroImage}
>
	<article>
		<header class="post-header">
			<p class="meta">
				<FormattedDate date={pubDate} lang={lang} />
				{
					updatedDate && (
						<span>
							· {t.updatedOn} <FormattedDate date={updatedDate} lang={lang} />
						</span>
					)
				}
			</p>
			<h1>{title}</h1>
			{
				tags.length > 0 && (
					<ul class="tags">
						{tags.map((tag) => (
							<li>#{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		{heroImage && <Image class="hero" width={1440} src={heroImage} alt="" />}

		{!hasTranslation && <p class="notice">{t.noTranslation}</p>}

		<div class="prose">
			<slot />
		</div>

		<a class="back" href={`/${lang}/`}>{t.backToList}</a>
	</article>
</BaseLayout>

<style>
	article {
		max-width: var(--width-prose);
		margin: 0 auto;
	}
	.post-header {
		margin-bottom: 2rem;
	}
	.meta {
		margin: 0 0 0.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--text-muted);
		font-size: 0.875rem;
	}
	.hero {
		width: 100%;
		height: auto;
		margin-bottom: 2rem;
		border-radius: var(--radius);
	}
	.notice {
		padding: 0.75rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.back {
		display: inline-block;
		margin-top: 3rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--text);
	}
</style>
