---
import { languages, type Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

// 소개 문구. 언어별로 여기만 고치면 된다.
const content = {
	ko: {
		title: '소개',
		body: ['안녕하세요, 주희입니다.', '여기에 자기소개를 적어주세요.'],
	},
	en: {
		title: 'About',
		body: ["Hi, I'm Juhee.", 'Write a short introduction here.'],
	},
}[lang];
---

<BaseLayout title={content.title} description={content.body[0]} lang={lang}>
	<article class="prose">
		<h1>{content.title}</h1>
		{content.body.map((p) => <p>{p}</p>)}
	</article>
</BaseLayout>

<style>
	article {
		max-width: var(--width-prose);
		margin: 2rem auto 0;
	}
</style>
