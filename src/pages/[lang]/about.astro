---
// 소개 페이지 (Katen about + 포트폴리오 "More about me" 구성)
import { Image } from 'astro:assets';
import aboutPhoto from '../../assets/about.jpg';
import filmingPhoto from '../../assets/about/interest-filming.jpg';
import musicPhoto from '../../assets/about/interest-music.jpg';
import trainingPhoto from '../../assets/about/interest-training.jpg';
import volunteeringPhoto from '../../assets/about/interest-volunteering.jpg';
import SocialIcons from '../../components/SocialIcons.astro';
import { languages, social, ui, type Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
// 관심사 카드 뒷면 사진 (content.interests 와 같은 순서)
const interestPhotos = [musicPhoto, filmingPhoto, volunteeringPhoto, trainingPhoto];

// 소개 문구는 여기만 고치면 된다
const content = {
	en: {
		title: 'About',
		greeting: 'Hey there, I’m Juhee Oh',
		bio: 'I’m a product designer with a strong customer-facing background. By working directly at user touchpoints, I listen deeply to users’ stories and turn them into meaningful digital experiences. I especially specialize in user-centered design, dynamic design systems, and iteration. I design with empathy at every touchpoint—so every experience truly serves the user.',
		resume: 'Check my resume',
		email: 'Email',
		interestsTitle: 'My Interests',
		interests: ['Sharing Music', 'Filming', 'Animal Shelter Volunteering', 'Strength Training'],
	},
	ko: {
		title: '소개',
		greeting: '안녕하세요, 오주희입니다',
		bio: '고객 접점에서 일해온 경험이 탄탄한 프로덕트 디자이너입니다. 사용자와 직접 만나는 자리에서 그들의 이야기를 깊이 듣고, 의미 있는 디지털 경험으로 바꿉니다. 특히 사용자 중심 디자인, 유연한 디자인 시스템, 반복 개선에 강합니다. 모든 접점에서 공감을 바탕으로 디자인해, 모든 경험이 정말로 사용자에게 도움이 되도록 합니다.',
		resume: '이력서 보기',
		email: '이메일',
		interestsTitle: '관심사',
		interests: ['음악 나누기', '영상 촬영', '유기동물 보호소 봉사', '근력 운동'],
	},
}[lang];
---

<BaseLayout title={`${content.title} | ${t.siteTitle}`} description={content.bio} lang={lang}>
	<section class="page-header">
		<div class="container">
			<h1>{content.title}</h1>
			<nav aria-label={t.breadcrumb}>
				<ol class="breadcrumb">
					<li><a href={`/${lang}/`}>{t.navHome}</a></li>
					<li aria-current="page">{content.title}</li>
				</ol>
			</nav>
		</div>
	</section>

	<div class="container">
		<section class="intro">
			<Image class="photo" src={aboutPhoto} width={900} alt={t.author} />
			<div class="intro-text">
				<h2>{content.greeting}</h2>
				<p>{content.bio}</p>
				<div class="actions">
					<a class="btn-default" href={social.resume[lang]} target="_blank" rel="noopener">{content.resume}</a>
					<a class="email" href={`mailto:${social.email}`}>{content.email}</a>
				</div>
				<hr />
				<SocialIcons />
			</div>
		</section>

		<section class="interests" aria-labelledby="interests-title">
			<header class="section-header">
				<h2 id="interests-title">{content.interestsTitle}</h2>
				<svg class="wave" width="33" height="6" viewBox="0 0 33 6" fill="none" aria-hidden="true"><path d="M1 3c2.7-2.7 5.3-2.7 8 0s5.3 2.7 8 0 5.3-2.7 8 0 5.3 2.7 7 0" stroke="url(#w)" stroke-width="2" stroke-linecap="round"></path><defs><linearGradient id="w" x1="0" x2="33" y1="0" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#fe4f70"></stop><stop offset="1" stop-color="#ffa387"></stop></linearGradient></defs></svg>
			</header>
			<ol class="interest-list">
				{
					content.interests.map((item, i) => (
						<li class="interest" tabindex="0" data-flip>
							<div class="card" data-flip-card>
								<div class="face front">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<span class="label">{item}</span>
								</div>
								<div class="face back">
									<Image src={interestPhotos[i]} widths={[400, 800]} sizes="(max-width: 575px) 50vw, 270px" alt={item} />
									<span class="chip">{item}</span>
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</div>
</BaseLayout>

<style>
	/* page-header: 가운데 제목·브레드크럼 + 콘텐츠 폭 구분선 */
	.page-header {
		padding-top: 40px;
		text-align: center;
	}
	/* 아래 구분선: 카드와 모서리가 맞도록 콘텐츠 폭에만 */
	.page-header .container::after {
		content: '';
		display: block;
		height: 1px;
		margin-top: 40px;
		background: var(--border);
	}
	.page-header h1 {
		margin: 0 0 6px;
		font-size: 32px;
	}
	.breadcrumb {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--body);
		font-size: 14px;
	}
	.breadcrumb li + li::before {
		content: '/';
		margin-right: 0.5rem;
	}
	.breadcrumb a {
		color: var(--body);
	}
	.breadcrumb a:hover {
		color: var(--pink);
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 40px;
		align-items: center;
		margin-top: 60px;
		padding: 30px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--card);
	}
	.photo {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
	}
	.intro h2 {
		margin: 0 0 16px;
		font-size: 30px;
		line-height: 1.3;
	}
	.intro p {
		margin: 0 0 24px;
		color: var(--body);
		font-size: 16px;
		line-height: 1.8;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px;
	}
	.btn-default {
		display: inline-block;
		padding: 9.5px 36px;
		border-radius: 25px;
		background: var(--gradient);
		background-size: 200% auto;
		color: #fff;
		font-family: var(--font-head);
		font-size: 14px;
		transition: background-position 0.3s ease-in-out;
	}
	.btn-default:hover {
		color: #fff;
		background-position: right center;
	}
	.email {
		color: var(--heading);
		font-family: var(--font-head);
		font-size: 14px;
		font-weight: 600;
	}
	.email:hover {
		color: var(--pink);
	}
	hr {
		margin: 24px 0;
		border: 0;
		border-top: 1px solid var(--border);
	}

	.interests {
		margin-top: 60px;
	}
	.section-header {
		margin-bottom: 30px;
	}
	.section-header h2 {
		margin: 0;
		font-size: 24px;
	}
	.wave {
		display: block;
		margin-top: 10px;
	}
	/* 포트폴리오의 번호 타일을 Katen 카드로. 짝수 칸은 살짝 내려 계단처럼 */
	.interest-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		margin: 0;
		padding: 0 0 40px;
		list-style: none;
	}
	/* 카드는 앞면(번호·이름)과 뒷면(사진) 두 장. 올리면 Y축으로 뒤집혀 사진이 나온다 */
	.interest {
		height: 300px;
		perspective: 1900px;
		cursor: pointer;
		outline: none;
		transition: transform 0.3s ease-in-out;
	}
	.interest:nth-child(even) {
		transform: translateY(40px);
	}
	.card {
		position: relative;
		height: 100%;
		transform-style: preserve-3d;
	}
	.face {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: var(--radius);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.front {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 30px;
		border: 1px solid var(--border);
		background: var(--card);
	}
	.interest:focus-visible .front {
		border-color: var(--pink);
	}
	.back {
		transform: rotateY(180deg);
		background: var(--surface);
	}
	.back img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.chip {
		position: absolute;
		bottom: 16px;
		left: 16px;
		padding: 6px 12px;
		border-radius: 25px;
		background: var(--gradient);
		background-size: 200% auto;
		color: #fff;
		font-family: var(--font-head);
		font-size: 13px;
		line-height: 1.2;
	}
	.num {
		background: var(--gradient);
		background-size: 200% auto;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-family: var(--font-head);
		font-size: 40px;
		font-weight: 700;
		line-height: 1;
	}
	.label {
		color: var(--heading);
		font-family: var(--font-head);
		font-size: 20px;
		font-weight: 700;
		line-height: 1.3;
	}

	@media (max-width: 991px) {
		.intro {
			grid-template-columns: 1fr;
		}
		.interest-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 575px) {
		.intro {
			padding: 20px;
		}
		.intro h2 {
			font-size: 24px;
		}
		.interest {
			height: 220px;
		}
		.front {
			padding: 20px;
		}
		.interest:nth-child(even) {
			transform: translateY(24px);
		}
	}
</style>

<script>
	// 관심사 카드 뒤집기 (GSAP). 마우스는 올리면 뒤집히고 벗어나면 돌아온다.
	// 터치는 누를 때마다, 키보드는 Tab 으로 들어오면 뒤집힌다. 동작 줄이기 설정이면 바로 바뀐다.
	import gsap from 'gsap';

	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const item of document.querySelectorAll<HTMLElement>('[data-flip]')) {
		const card = item.querySelector<HTMLElement>('[data-flip-card]')!;
		let flipped = false;
		const flip = (on: boolean) => {
			flipped = on;
			gsap.to(card, { rotationY: on ? 180 : 0, duration: reduce ? 0 : 1.4, ease: 'power2.inOut', overwrite: true });
		};

		item.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && flip(true));
		item.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && flip(false));
		item.addEventListener('click', (e) => {
			if ((e as PointerEvent).pointerType !== 'mouse') flip(!flipped);
		});
		item.addEventListener('focus', () => item.matches(':focus-visible') && flip(true));
		item.addEventListener('blur', () => flip(false));
		item.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				flip(!flipped);
			}
		});
	}
</script>
