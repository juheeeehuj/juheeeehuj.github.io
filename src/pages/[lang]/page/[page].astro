---
import HomeFeed from '../../../components/HomeFeed.astro';
import { getPosts, languages, otherLang, PAGE_SIZE, ui, type Lang } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// 2페이지부터. 1페이지는 /<lang>/ 이다.
export async function getStaticPaths() {
	const paths = [];
	for (const lang of Object.keys(languages) as Lang[]) {
		const total = Math.ceil((await getPosts(lang)).length / PAGE_SIZE);
		for (let page = 2; page <= total; page++) paths.push({ params: { lang, page: String(page) } });
	}
	return paths;
}

const { lang, page } = Astro.params as { lang: Lang; page: string };
const t = ui[lang];
const posts = await getPosts(lang);
const other = otherLang(lang);
const otherTotal = Math.ceil((await getPosts(other)).length / PAGE_SIZE);
const pageNum = Number(page);
const self = `/${lang}/page/${page}/`;
const otherUrl = pageNum <= otherTotal ? `/${other}/page/${page}/` : `/${other}/`;
const alternates = { [lang]: self, [other]: otherUrl } as Record<Lang, string>;
---

<BaseLayout
	title={`${t.siteTitle} · ${page}`}
	description={t.siteDescription}
	lang={lang}
	alternates={alternates}
	hreflang={pageNum <= otherTotal ? alternates : { [lang]: self }}
	header="personal"
>
	<HomeFeed lang={lang} posts={posts} page={pageNum} />
</BaseLayout>
