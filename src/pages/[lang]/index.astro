---
import HomeFeed from '../../components/HomeFeed.astro';
import { getPosts, languages, ui, type Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
const posts = await getPosts(lang);
---

<BaseLayout title={t.siteTitle} description={t.siteDescription} lang={lang} header="personal">
	<HomeFeed lang={lang} posts={posts} page={1} />
</BaseLayout>
