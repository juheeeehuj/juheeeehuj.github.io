---
// 그림(또는 영상) 한 장 + 캡션
import MediaItem from './MediaItem.astro';

interface Props {
	src: string;
	caption?: string;
	/** 표시 최대 폭(px). 기본은 본문 전체 폭 */
	width?: number;
	/** 모서리를 둥글게 자르지 않는다 (테두리가 그려진 표·문서 그림) */
	square?: boolean;
}

const { src, caption, width = 1000, square = false } = Astro.props;
---

<div class:list={['case-figure', { square }]} style={`max-width: ${width}px`}>
	<MediaItem src={src} caption={caption} width={width} />
</div>
