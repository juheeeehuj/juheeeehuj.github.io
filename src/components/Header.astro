---
// 헤더 두 가지 (Katen)
//   personal: 홈 전용. 가운데 프로필·이름·소개, 아래 알약 메뉴
//   compact : 그 밖의 페이지. 한 줄에 로고 · 메뉴 · 아이콘
import { blogUrl, ui, type Lang } from '../i18n/ui';
import Avatar from './Avatar.astro';
import LanguageToggle from './LanguageToggle.astro';
import NavLinks from './NavLinks.astro';
import Search from './Search.astro';
import SocialIcons from './SocialIcons.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	lang: Lang;
	alternates: Record<Lang, string>;
	/** 강조할 메뉴 주소. 생략하면 현재 경로로 판단한다 */
	active?: string;
	variant?: 'personal' | 'compact';
}

const { lang, alternates, active, variant = 'compact' } = Astro.props;
const t = ui[lang];
const path = active ?? Astro.url.pathname;
const home = `/${lang}/`;
const blog = blogUrl(lang);
const links = [
	{ href: home, label: t.navHome, active: path === home },
	{ href: `/${lang}/work/`, label: t.navWork, active: path.startsWith(`/${lang}/work`) },
	// 카테고리(프로덕트·디자인·AI)와 글은 모두 블로그 안에 있다
	{ href: blog, label: t.navBlog, active: path.startsWith(blog) },
	{ href: `/${lang}/about/`, label: t.navAbout, active: path.startsWith(`/${lang}/about`) },
];
---

<header class:list={['site-header', variant]}>
	{
		variant === 'personal' ? (
			<div class="container header-top">
				<div class="left">
					<SocialIcons />
				</div>
				<div class="center">
					<a class="avatar-link" href={home} aria-hidden="true" tabindex="-1">
						<Avatar size={80} />
					</a>
					<a class="text-logo" href={home}>{t.siteTitle}<span class="dot">.</span></a>
					<span class="slogan">{t.siteDescription}</span>
				</div>
				<div class="right">
					<Search lang={lang} />
					<LanguageToggle lang={lang} alternates={alternates} />
					<ThemeToggle lang={lang} />
				</div>
			</div>
		) : (
			<div class="container compact-row">
				<a class="text-logo" href={home}>{t.siteTitle}<span class="dot">.</span></a>
				<div class="compact-nav">
					<NavLinks links={links} align="start" />
				</div>
				<div class="right">
					<span class="socials">
						<SocialIcons />
					</span>
					<Search lang={lang} />
					<LanguageToggle lang={lang} alternates={alternates} />
					<ThemeToggle lang={lang} />
				</div>
			</div>
		)
	}

	{
		variant === 'personal' && (
			<div class="container personal-nav">
				<NavLinks links={links} />
			</div>
		)
	}
</header>

<style>
	.right {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 10px;
	}
	.text-logo {
		display: block;
		color: var(--heading);
		font-family: var(--font-head);
		font-size: 30px;
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
	}
	.text-logo .dot {
		margin-left: 3px;
		color: var(--pink);
		font-size: 44px;
		line-height: 0;
	}

	/* ── personal (홈) ── */
	.header-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		padding-top: 30px;
		padding-bottom: 30px;
	}
	.center {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.avatar-link {
		display: inline-flex;
		margin-bottom: 14px;
	}
	.personal .text-logo {
		margin: 0 0 5px;
	}
	.slogan {
		color: var(--text-subtle);
		font-family: var(--font-head);
		font-size: 14px;
	}

	/* ── compact (홈 밖의 페이지) ── */
	.compact-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-top: 30px;
	}
	.compact .text-logo {
		font-size: 26px;
	}
	.compact .text-logo .dot {
		font-size: 38px;
	}
	.socials {
		display: inline-flex;
		margin-right: 14px;
	}

	.personal-nav {
		padding: 20px 0;
		border-top: 1px solid var(--border);
	}

	/* 넓은 화면: 로고 · 메뉴 · 아이콘 한 줄 / 좁은 화면: 메뉴가 아래 줄로 */
	.compact-row {
		flex-wrap: wrap;
		padding-bottom: 30px;
	}
	.compact-nav {
		flex: 1;
		min-width: 0;
	}
	@media (max-width: 991px) {
		.compact-nav {
			flex-basis: 100%;
			order: 3;
			margin: 0 -1rem;
		}
	}

	@media (max-width: 767px) {
		.header-top {
			grid-template-columns: 1fr;
		}
		.left,
		.socials {
			display: none;
		}
		.personal .right {
			justify-content: center;
		}
		.compact .text-logo {
			font-size: 22px;
		}
		.compact-nav {
			margin: 0;
		}
	}
</style>
