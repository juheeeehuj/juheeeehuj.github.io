---
// 글 하단: 이전/다음 글 (텍스트 줄). 개발 모드에서는 초안도 '초안' 표시와 함께 연결한다
import type { CollectionEntry } from 'astro:content';
import { selectPostRecommendations } from '../blog-posts.mjs';
import { getPosts, postUrl, slugFromId, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  currentId: string;
}

const { lang, currentId } = Astro.props;
const { previous, next } = selectPostRecommendations(await getPosts(lang), currentId, {
  includeDrafts: import.meta.env.DEV,
});

const t = ui[lang];
const draftLabel = lang === 'ko' ? '초안' : 'Draft';
const adjacent = [
  previous && { post: previous, dir: 'prev', label: t.previousPost },
  next && { post: next, dir: 'next', label: t.nextPost },
].filter(Boolean) as { post: CollectionEntry<'blog'>; dir: 'prev' | 'next'; label: string }[];
---

{adjacent.length > 0 && (
  <nav class="post-navigation" aria-label={t.postNavigation}>
    {adjacent.map(({ post, dir, label }) => (
      <a class:list={['adjacent-post', dir]} href={postUrl(lang, slugFromId(post.id))} rel={dir}>
        <span class="adjacent-text">
          <span class="adjacent-label">
            {dir === 'prev' && <span aria-hidden="true">← </span>}{label}{dir === 'next' && <span aria-hidden="true"> →</span>}
          </span>
          <strong>{post.data.draft && <span class="draft-tag">{draftLabel}</span>}{post.data.title}</strong>
        </span>
      </a>
    ))}
  </nav>
)}

<style>
  .post-navigation {
    margin-top: 40px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .adjacent-post { display: block; padding: 18px 4px; }
  .adjacent-post + .adjacent-post { border-top: 1px solid var(--border); }
  .adjacent-text {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
  }
  .adjacent-label { color: var(--text-subtle); font-size: 13px; }
  .adjacent-post strong {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    color: var(--heading);
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .adjacent-post:hover strong { color: var(--pink); }
  .draft-tag {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 8px;
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text-subtle);
    font-size: 12px;
    font-weight: 400;
    vertical-align: 2px;
  }

  @media (max-width: 575px) {
    .adjacent-text { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .adjacent-post strong { -webkit-line-clamp: 2; }
  }
</style>
