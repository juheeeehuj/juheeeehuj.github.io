---
// 홈(1페이지)과 /page/N/ 이 같이 쓰는 본문: 슬라이드(1페이지만) + 글 카드 + 페이지 번호
import type { CollectionEntry } from 'astro:content';
import { PAGE_SIZE, type Lang } from '../i18n/ui';
import FeaturedSlider from './FeaturedSlider.astro';
import Pagination from './Pagination.astro';
import PostGrid from './PostGrid.astro';

interface Props {
	lang: Lang;
	posts: CollectionEntry<'blog'>[];
	page: number;
}

const { lang, posts, page } = Astro.props;
const total = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const pagePosts = posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
// 추천 글이 3개 미만이면 슬라이드가 비어 보여서 숨긴다
const featured = posts.filter((p) => p.data.featured);
const showSlider = page === 1 && featured.length >= 3;
---

{showSlider && <FeaturedSlider lang={lang} posts={featured} />}

<section class="container main-content">
	<PostGrid lang={lang} posts={pagePosts} />
	<Pagination lang={lang} current={page} total={total} />
</section>

<style>
	.main-content {
		margin-top: 60px;
	}
</style>
