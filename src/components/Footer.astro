---
import { social } from '../i18n/ui';

const year = new Date().getFullYear();
---

<footer>
	<span>&copy; {year} Juhee Oh</span>
	<a href={social.github} target="_blank" rel="noopener">GitHub</a>
</footer>

<style>
	footer {
		display: flex;
		justify-content: center;
		gap: 1rem;
		padding: 3rem 1rem 4rem;
		color: var(--text-muted);
		font-size: 0.875rem;
	}
	a {
		color: inherit;
	}
	a:hover {
		color: var(--text);
	}
</style>
