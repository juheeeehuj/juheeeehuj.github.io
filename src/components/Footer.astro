---
import { ui, type Lang } from '../i18n/ui';
import SocialIcons from './SocialIcons.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="container">
	<div class="footer-inner">
		<span class="copyright">&copy; {year} Juhee Oh.</span>
		<SocialIcons />
		<a href="#top" class="return-to-top">
			<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 7-7 7 7M12 19V5"></path></svg>
			{ui[lang].backToTop}
		</a>
	</div>
</footer>

<style>
	footer {
		margin-top: 50px;
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1.5rem;
		padding: 40px 0;
		border-top: 1px solid var(--border);
	}
	.copyright {
		color: var(--text-subtle);
	}
	.return-to-top {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		justify-self: end;
		padding: 6px 20px;
		border: 1px solid var(--border);
		border-radius: 25px;
		color: var(--text-muted);
		font-size: 13px;
		transition: all 0.3s ease-in-out;
	}
	.return-to-top:hover {
		border-color: var(--pink);
		color: var(--pink);
	}
	@media (max-width: 767px) {
		.footer-inner {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}
		.return-to-top {
			justify-self: center;
		}
	}
</style>
