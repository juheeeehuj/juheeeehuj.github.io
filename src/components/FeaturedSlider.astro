---
// 홈 상단 추천 글 슬라이드 (Katen hero-carousel). featured: true 글만 올라간다.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryLabels, categoryUrl, postUrl, slugFromId, ui, type Lang } from '../i18n/ui';
import FormattedDate from './FormattedDate.astro';

interface Props {
	lang: Lang;
	posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const t = ui[lang];
---

<section class="hero-carousel" aria-label={t.featured} data-carousel>
	<div class="track" data-track>
		{
			posts.map((post) => {
				const { title, category, pubDate, heroImage } = post.data;
				return (
					<article class="featured-post">
						<div class="thumb">
							{heroImage ? (
								<Image class="inner" src={heroImage} width={640} alt="" />
							) : (
								<div class="inner placeholder" />
							)}
						</div>
						<div class="details">
							{category && (
								<a class="category-badge" href={categoryUrl(lang, category)}>
									{categoryLabels[lang][category]}
								</a>
							)}
							<h3 class="post-title">
								<a href={postUrl(lang, slugFromId(post.id))}>{title}</a>
							</h3>
							<ul class="meta">
								<li>{t.author}</li>
								<li>
									<FormattedDate date={pubDate} lang={lang} month="short" />
								</li>
							</ul>
						</div>
					</article>
				);
			})
		}
	</div>
	<div class="dots" data-dots></div>
</section>

<style>
	.hero-carousel {
		--gap: 20px;
		--visible: 5;
		padding: 0 15px;
	}
	.track {
		display: flex;
		gap: var(--gap);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.featured-post {
		position: relative;
		flex: 0 0 calc((100% - (var(--visible) - 1) * var(--gap)) / var(--visible));
		height: 356px;
		scroll-snap-align: start;
		border-radius: var(--radius);
		overflow: hidden;
	}
	.thumb {
		position: absolute;
		inset: 0;
	}
	/* 이미지 위에 네이비를 60% 깔아 흰 글자가 읽히게 */
	.thumb::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--overlay);
		opacity: 0.6;
	}
	.inner {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease-in-out;
	}
	.placeholder {
		background: linear-gradient(135deg, #fe4f70 0%, #ffa387 100%);
	}
	.featured-post:hover .inner {
		transform: scale(1.05);
	}
	.details {
		position: absolute;
		top: 50%;
		z-index: 1;
		width: 100%;
		padding: 0 30px;
		text-align: center;
		transform: translateY(-50%);
	}
	.category-badge {
		position: relative;
		z-index: 2;
	}
	.post-title {
		margin: 15px 0;
		font-size: 22px;
	}
	.post-title a {
		color: #fff;
	}
	/* 제목 링크가 카드 전체를 덮어서 어디를 눌러도 글로 간다 */
	.post-title a::after {
		content: '';
		position: absolute;
		inset: -100vh -100vw;
	}
	.featured-post {
		isolation: isolate;
	}
	.meta {
		justify-content: center;
		color: rgba(255, 255, 255, 0.6);
	}
	.meta li:not(:last-child)::after {
		background: rgba(255, 255, 255, 0.6);
	}

	.dots {
		display: flex;
		justify-content: center;
		gap: 10px;
		margin-top: 25px;
		min-height: 8px;
	}
	.dots :global(button) {
		width: 8px;
		height: 8px;
		padding: 0;
		border: 0;
		border-radius: 5px;
		background: #d4d4d4;
		cursor: pointer;
		transition: width 0.2s ease-in-out;
	}
	.dots :global(button[aria-current='true']) {
		width: 25px;
		background: linear-gradient(to right, #fe4f70 0%, #ffa387 100%);
	}

	@media (max-width: 1199px) {
		.hero-carousel {
			--visible: 4;
		}
	}
	@media (max-width: 991px) {
		.hero-carousel {
			--visible: 3;
		}
	}
	@media (max-width: 767px) {
		.hero-carousel {
			--visible: 2;
		}
	}
	@media (max-width: 575px) {
		.hero-carousel {
			--visible: 1.15;
		}
	}
</style>

<script>
	// 한 화면에 보이는 카드 묶음을 한 페이지로 보고 점(dot)을 만든다
	for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
		const track = root.querySelector<HTMLElement>('[data-track]')!;
		const dots = root.querySelector<HTMLElement>('[data-dots]')!;
		const step = () => track.clientWidth + parseFloat(getComputedStyle(track).columnGap || '0');
		const pageCount = () => Math.max(1, Math.ceil((track.scrollWidth - track.clientWidth) / step() - 0.01) + 1);

		const render = () => {
			const n = pageCount();
			dots.replaceChildren(
				...Array.from({ length: n > 1 ? n : 0 }, (_, i) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.ariaLabel = `${i + 1} / ${n}`;
					b.addEventListener('click', () => track.scrollTo({ left: i * step() }));
					return b;
				}),
			);
			update();
		};
		const update = () => {
			const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
			const current = atEnd ? dots.children.length - 1 : Math.round(track.scrollLeft / step());
			[...dots.children].forEach((b, i) => b.setAttribute('aria-current', String(i === current)));
		};

		track.addEventListener('scroll', update, { passive: true });
		new ResizeObserver(render).observe(track);
	}
</script>
