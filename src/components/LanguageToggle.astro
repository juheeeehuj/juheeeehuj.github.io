---
// 한/영 전환. 번역본이 있으면 같은 글로, 없으면 상대 언어 홈으로 간다.
import { languages, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	alternates: Record<Lang, string>;
}

const { lang, alternates } = Astro.props;
---

<div class="lang-toggle" role="group" aria-label="Language">
	{
		(Object.keys(languages) as Lang[]).map((l) => (
			<a
				href={alternates[l]}
				class:list={['lang-btn', { active: l === lang }]}
				aria-current={l === lang ? 'true' : undefined}
				hreflang={l}
				lang={l}
				data-lang-pref={l}
			>
				{l.toUpperCase()}
			</a>
		))
	}
</div>

<script>
	// 고른 언어를 기억해 두면 다음에 첫 주소('/')로 들어올 때 그 언어로 간다 (src/pages/index.astro)
	document.addEventListener('click', (e) => {
		const link = (e.target as HTMLElement).closest<HTMLElement>('[data-lang-pref]');
		if (!link) return;
		try {
			localStorage.setItem('lang', link.dataset.langPref!);
		} catch (_) {}
	});
</script>

<style>
	.lang-toggle {
		display: inline-flex;
		height: 37px;
		padding: 3px;
		border: 1px solid var(--border);
		border-radius: 25px;
		background: var(--card);
	}
	.lang-btn {
		display: inline-flex;
		align-items: center;
		padding: 0 0.8rem;
		border-radius: 25px;
		color: var(--menu);
		font-family: var(--font-head);
		font-size: 12px;
		font-weight: 600;
	}
	.lang-btn:hover {
		color: var(--heading);
	}
	.lang-btn.active {
		background: var(--gradient);
		background-size: 200% auto;
		color: #fff;
	}
</style>
