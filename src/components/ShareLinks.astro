---
// 글 하단 공유 아이콘. 추적 스크립트 없이 각 서비스의 공유 주소로만 연결한다.
import { ui, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	url: string;
	title: string;
}

const { lang, url, title } = Astro.props;
const t = ui[lang];
const u = encodeURIComponent(url);
const text = encodeURIComponent(title);
const links = [
	{
		name: 'X',
		href: `https://x.com/intent/post?url=${u}&text=${text}`,
		icon: '<path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.9 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/>',
	},
	{
		name: 'LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
		icon: '<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45Z"/>',
	},
	{
		name: 'Facebook',
		href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
		icon: '<path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.3c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2H7.6V12h2.7v9.8H14V12h2.8l.4-3.5H14Z"/>',
	},
	{
		name: 'Email',
		href: `mailto:?subject=${text}&body=${u}`,
		icon: '<path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.3V17h16V7.3l-8 5.4-8-5.4ZM5.6 7l6.4 4.3L18.4 7H5.6Z"/>',
	},
];
---

<ul class="share-links" aria-label={t.shareOn}>
	{
		links.map((l) => (
			<li>
				<a href={l.href} target="_blank" rel="noopener" aria-label={`${t.shareOn} ${l.name}`}>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={l.icon} />
				</a>
			</li>
		))
	}
	<li>
		<button type="button" data-share={url} aria-label={t.share} title={t.share}>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1"></path><path d="M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"></path></svg>
			<span class="copied" data-copied hidden>{t.copied}</span>
		</button>
	</li>
</ul>

<style>
	.share-links {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a,
	button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--heading);
		cursor: pointer;
	}
	a:hover,
	button:hover {
		color: var(--pink);
	}
	.copied {
		font-size: 13px;
	}
</style>

<script>
	// 링크 복사 (PostCard 와 같은 data-share 규칙)
	document.addEventListener('click', async (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.share-links [data-share]');
		if (!btn) return;
		try {
			await navigator.clipboard.writeText(new URL(btn.dataset.share!, location.href).href);
		} catch {
			return;
		}
		const label = btn.querySelector<HTMLElement>('[data-copied]');
		if (!label) return;
		label.hidden = false;
		setTimeout(() => (label.hidden = true), 1600);
	});
</script>
