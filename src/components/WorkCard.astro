---
// 작업 카드: 커버 · 라벨 · 제목 · 요약 · 유형/기간
//   wide 면 가로로 길게 (커버 왼쪽, 글 오른쪽) — 홈 Selected Work 첫 칸
//   커버는 잘라내지 않고 원래 비율 그대로 보여준다
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { slugFromId, workUrl, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	work: CollectionEntry<'work'>;
	wide?: boolean;
	/** 제목 태그 (목록 페이지는 h2, 홈 섹션 안에서는 h3) */
	as?: 'h2' | 'h3';
}

const { lang, work, wide = false, as: Heading = 'h2' } = Astro.props;
const url = workUrl(lang, slugFromId(work.id));
const { cover, kicker, title, description, projectType, duration } = work.data;
---

<article class:list={['work-card', { wide }]}>
	<a class="thumb" href={url} tabindex="-1" aria-hidden="true" style={`aspect-ratio: ${cover.width} / ${cover.height}`}>
		<Image
			src={cover}
			widths={[600, 1200, 1800].map((w) => Math.min(w, cover.width))}
			sizes={wide ? '(max-width: 767px) 100vw, 680px' : '(max-width: 767px) 100vw, 555px'}
			quality={90}
			alt=""
		/>
	</a>
	<div class="details">
		<span class="category-badge">{kicker}</span>
		<Heading class="card-title">
			<a href={url}>{title}</a>
		</Heading>
		<p class="excerpt">{description}</p>
		<ul class="meta">
			<li>{projectType}</li>
			<li>{duration}</li>
		</ul>
	</div>
</article>

<style>
	.work-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--card);
		overflow: hidden;
	}
	/* 커버는 잘라내지 않는다: 칸 비율을 이미지 비율에 맞춘다 (아래 해시태그까지 다 보이게) */
	.thumb {
		display: block;
		overflow: hidden;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease-in-out;
	}
	.work-card:hover .thumb img {
		transform: scale(1.05);
	}
	.details {
		flex: 1;
		padding: 30px;
	}
	.card-title {
		margin: 14px 0 10px;
		font-size: 22px;
		line-height: 1.35;
	}
	.card-title a {
		color: var(--heading);
	}
	.card-title a:hover {
		color: var(--pink);
	}
	.excerpt {
		margin: 0 0 16px;
		color: var(--text-muted);
		font-size: 15px;
	}

	/* 가로형: 커버 왼쪽 3/5, 글 오른쪽 */
	.wide {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
	}
	/* 카드 높이 = 커버 높이. 글은 그 안에 들어가도록 줄 수를 줄인다 */
	.wide .excerpt {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.wide .details {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 40px;
	}
	.wide .category-badge {
		align-self: flex-start;
	}
	.wide .card-title {
		font-size: 26px;
	}

	@media (max-width: 767px) {
		.details,
		.wide .details {
			padding: 24px;
		}
		.wide {
			display: flex;
		}
	}
</style>
